{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethglobaltokyo-bio-agent-sepolia",
  "main": "services/sepolia/worker.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": { "directory": "./dist/sepolia-demo", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "vars": { "STIMULUS_ENABLED": "true" },
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "STIMULUS_SENDER", "class_name": "StimulusScheduler" }] },
  "migrations": [{ "tag": "v1-stimulus-scheduler", "new_sqlite_classes": ["StimulusScheduler"] }],
}
